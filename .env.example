# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Anthropic / Claude ─────────────────────────────────────────────────────────
# Required for email classification and draft generation
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model override (optional — defaults to config.yaml setting)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Google OAuth Credentials ───────────────────────────────────────────────────
# Path to the OAuth 2.0 credentials JSON downloaded from Google Cloud Console.
# In Google Cloud Console:
#   1. Create a project → Enable Gmail API
#   2. OAuth consent screen → Add scopes: gmail.modify, gmail.compose
#   3. Credentials → Create OAuth 2.0 Client ID (Web application)
#   4. Add Authorized redirect URI: http://localhost:8000/auth/google/callback
#   5. Download JSON → save as auth/credentials.json
GOOGLE_CLIENT_SECRETS_FILE=auth/credentials.json

# ── API Server (for web mode) ──────────────────────────────────────────────────
# Public URL of this backend (used for Google OAuth callback URI)
BACKEND_URL=http://localhost:8000

# URL of the Lovable/React frontend (for CORS and post-OAuth redirect)
FRONTEND_URL=http://localhost:8080

# ── Google Workspace CLI — Model Armor (optional) ─────────────────────────────
# GOOGLE_WORKSPACE_CLI_SANITIZE_TEMPLATE=your_template_id
# GOOGLE_WORKSPACE_CLI_SANITIZE_MODE=warn
