# Copy this file to .env and fill in your values
# cp .env.example .env

# Anthropic API Key (required for classification and draft generation)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model override (optional — defaults to config.yaml setting)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Google Workspace CLI — Model Armor (optional, for enhanced security)
# GOOGLE_WORKSPACE_CLI_SANITIZE_TEMPLATE=your_template_id
# GOOGLE_WORKSPACE_CLI_SANITIZE_MODE=warn
