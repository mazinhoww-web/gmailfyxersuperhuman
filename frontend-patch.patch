diff --git a/src/services/ariaApi.ts b/src/services/ariaApi.ts
new file mode 100644
index 0000000..bc868df
--- /dev/null
+++ b/src/services/ariaApi.ts
@@ -0,0 +1,226 @@
+/**
+ * ARIA Backend API Client
+ * Connects the Lovable frontend to the FastAPI/Python backend.
+ */
+
+const ARIA_API_URL = import.meta.env.VITE_ARIA_API_URL || "http://localhost:8000";
+
+// ─── Session Management ───────────────────────────────────────────────────────
+
+const SESSION_KEY = "aria_session";
+
+export function getSession(): string | null {
+  return localStorage.getItem(SESSION_KEY);
+}
+
+export function setSession(token: string): void {
+  localStorage.setItem(SESSION_KEY, token);
+}
+
+export function clearSession(): void {
+  localStorage.removeItem(SESSION_KEY);
+}
+
+// ─── HTTP Helper ──────────────────────────────────────────────────────────────
+
+async function request<T>(
+  path: string,
+  options: RequestInit & { params?: Record<string, string | number | boolean | undefined> } = {}
+): Promise<T> {
+  const session = getSession();
+  const { params, ...fetchOptions } = options;
+
+  const url = new URL(`${ARIA_API_URL}${path}`);
+  if (session) url.searchParams.set("session", session);
+  if (params) {
+    Object.entries(params).forEach(([k, v]) => {
+      if (v !== undefined) url.searchParams.set(k, String(v));
+    });
+  }
+
+  const res = await fetch(url.toString(), {
+    ...fetchOptions,
+    credentials: "include",
+    headers: {
+      "Content-Type": "application/json",
+      ...fetchOptions.headers,
+    },
+  });
+
+  if (!res.ok) {
+    const err = await res.json().catch(() => ({ detail: res.statusText }));
+    throw new Error(err.detail || `API error ${res.status}`);
+  }
+
+  return res.json();
+}
+
+// ─── Auth ─────────────────────────────────────────────────────────────────────
+
+/** Redirect user to the backend's Google OAuth (with Gmail scopes). */
+export function startGmailAuth(supabaseUserId?: string): void {
+  const url = new URL(`${ARIA_API_URL}/auth/google`);
+  if (supabaseUserId) url.searchParams.set("user_id", supabaseUserId);
+  window.location.href = url.toString();
+}
+
+export async function getAriaUser(): Promise<{
+  user_id: string;
+  email: string;
+  name: string;
+  picture: string;
+  authenticated: boolean;
+}> {
+  return request("/auth/me");
+}
+
+export async function logout(): Promise<void> {
+  const session = getSession();
+  if (session) {
+    await request("/auth/logout", {
+      method: "POST",
+      params: { session },
+    }).catch(() => {});
+  }
+  clearSession();
+}
+
+// ─── Emails ───────────────────────────────────────────────────────────────────
+
+export interface Email {
+  id: string;
+  thread_id: string;
+  subject: string;
+  from: string;
+  to: string;
+  date: string;
+  snippet: string;
+  is_unread: boolean;
+  label_ids: string[];
+  category: string | null;
+}
+
+export interface EmailDetail extends Email {
+  body: string;
+}
+
+export async function listEmails(
+  folder: "inbox" | "unread" | "sent" = "inbox",
+  maxResults = 50
+): Promise<{ emails: Email[]; total: number }> {
+  return request("/emails", { params: { folder, max_results: maxResults } });
+}
+
+export async function getEmail(messageId: string): Promise<EmailDetail> {
+  return request(`/emails/${messageId}`);
+}
+
+export async function getThread(messageId: string): Promise<{
+  thread_id: string;
+  summary: string;
+  messages: Array<{ id: string; from: string; date: string; body: string }>;
+}> {
+  return request(`/emails/${messageId}/thread`);
+}
+
+export async function classifyEmail(messageId: string): Promise<{ category: string }> {
+  return request(`/emails/${messageId}/classify`, { method: "POST" });
+}
+
+export async function archiveEmail(messageId: string): Promise<{ success: boolean }> {
+  return request(`/emails/${messageId}/archive`, { method: "POST" });
+}
+
+export async function processEmails(
+  maxEmails = 50,
+  dryRun = false
+): Promise<{
+  processed: number;
+  categories: Record<string, number>;
+  drafts_created: number;
+  errors: number;
+  dry_run: boolean;
+}> {
+  return request("/emails/process", {
+    method: "POST",
+    params: { max_emails: maxEmails, dry_run: dryRun },
+  });
+}
+
+// ─── Drafts ───────────────────────────────────────────────────────────────────
+
+export interface Draft {
+  draft_id: string;
+  content: string;
+  message_id?: string;
+}
+
+export async function generateDraft(
+  messageId: string,
+  threadId?: string
+): Promise<Draft> {
+  return request("/drafts/generate", {
+    method: "POST",
+    body: JSON.stringify({ message_id: messageId, thread_id: threadId }),
+  });
+}
+
+export async function sendDraft(draftId: string): Promise<{ success: boolean }> {
+  return request(`/drafts/${draftId}/send`, { method: "POST" });
+}
+
+export async function deleteDraft(draftId: string): Promise<{ success: boolean }> {
+  return request(`/drafts/${draftId}`, { method: "DELETE" });
+}
+
