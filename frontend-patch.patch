+/**
+ * Hooks for email data fetching and mutations using React Query.
+ */
+
+import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
+import {
+  listEmails,
+  getEmail,
+  getThread,
+  archiveEmail,
+  processEmails,
+  generateDraft,
+  sendDraft,
+  deleteDraft,
+  getCategories,
+  snoozeEmail,
+  type Email,
+} from "@/services/ariaApi";
+import { getSession } from "@/services/ariaApi";
+import { toast } from "sonner";
+
+// ─── Query Keys ───────────────────────────────────────────────────────────────
+
+export const emailKeys = {
+  all: ["emails"] as const,
+  list: (folder: string) => ["emails", "list", folder] as const,
+  detail: (id: string) => ["emails", "detail", id] as const,
+  thread: (id: string) => ["emails", "thread", id] as const,
+  categories: ["emails", "categories"] as const,
+};
+
+// ─── Queries ──────────────────────────────────────────────────────────────────
+
+export function useEmailList(folder: "inbox" | "unread" | "sent" = "inbox") {
+  const session = getSession();
+  return useQuery({
+    queryKey: emailKeys.list(folder),
+    queryFn: () => listEmails(folder),
+    enabled: !!session,
+    staleTime: 30_000,
+    refetchInterval: 60_000,
+  });
+}
+
+export function useEmail(messageId: string | null) {
+  const session = getSession();
+  return useQuery({
+    queryKey: emailKeys.detail(messageId!),
+    queryFn: () => getEmail(messageId!),
+    enabled: !!session && !!messageId,
+    staleTime: 60_000,
+  });
+}
+
+export function useEmailThread(messageId: string | null) {
+  const session = getSession();
+  return useQuery({
+    queryKey: emailKeys.thread(messageId!),
+    queryFn: () => getThread(messageId!),
+    enabled: !!session && !!messageId,
+    staleTime: 120_000,
+  });
+}
+
+export function useCategories() {
+  const session = getSession();
+  return useQuery({
+    queryKey: emailKeys.categories,
+    queryFn: getCategories,
+    enabled: !!session,
+    staleTime: 300_000,
+  });
+}
+
+// ─── Mutations ────────────────────────────────────────────────────────────────
+
+export function useArchiveEmail() {
+  const qc = useQueryClient();
+  return useMutation({
+    mutationFn: (messageId: string) => archiveEmail(messageId),
+    onSuccess: (_, messageId) => {
+      qc.invalidateQueries({ queryKey: emailKeys.all });
+      toast.success("E-mail arquivado");
+    },
+    onError: () => toast.error("Erro ao arquivar"),
+  });
+}
+
+export function useProcessEmails() {
+  const qc = useQueryClient();
+  return useMutation({
+    mutationFn: ({ maxEmails = 50, dryRun = false } = {}) =>
+      processEmails(maxEmails, dryRun),
+    onSuccess: (result) => {
+      qc.invalidateQueries({ queryKey: emailKeys.all });
+      toast.success(
+        `Processado: ${result.processed} e-mails · ${result.drafts_created} rascunhos gerados`
+      );
+    },
+    onError: () => toast.error("Erro ao processar e-mails"),
+  });
+}
+
+export function useGenerateDraft() {
+  return useMutation({
+    mutationFn: ({
+      messageId,
+      threadId,
+    }: {
+      messageId: string;
+      threadId?: string;
+    }) => generateDraft(messageId, threadId),
+    onSuccess: () => toast.success("Rascunho gerado por ARIA"),
+    onError: () => toast.error("Erro ao gerar rascunho"),
+  });
+}
+
+export function useSendDraft() {
+  const qc = useQueryClient();
+  return useMutation({
+    mutationFn: (draftId: string) => sendDraft(draftId),
+    onSuccess: () => {
+      qc.invalidateQueries({ queryKey: emailKeys.all });
+      toast.success("E-mail enviado!");
+    },
+    onError: () => toast.error("Erro ao enviar"),
+  });
+}
+
+export function useDeleteDraft() {
+  return useMutation({
+    mutationFn: (draftId: string) => deleteDraft(draftId),
+    onSuccess: () => toast.success("Rascunho descartado"),
+    onError: () => toast.error("Erro ao descartar"),
+  });
+}
+
+export function useSnoozeEmail() {
+  const qc = useQueryClient();
+  return useMutation({
+    mutationFn: ({ messageId, hours = 24 }: { messageId: string; hours?: number }) => {
+      const until = new Date(Date.now() + hours * 3_600_000);
+      return snoozeEmail(messageId, until);
+    },
+    onSuccess: () => {
+      qc.invalidateQueries({ queryKey: emailKeys.all });
+      toast.success("E-mail adiado");
+    },
+    onError: () => toast.error("Erro ao adiar"),
+  });
+}
+
+// ─── Helpers ──────────────────────────────────────────────────────────────────
+
+export const CATEGORY_COLOR_MAP: Record<string, string> = {
+  to_respond: "var(--cat-respond)",
+  fyi: "var(--cat-fyi)",
+  comment: "var(--cat-comment)",
+  notification: "var(--cat-notification)",
+  meeting_update: "var(--cat-meeting)",
+  awaiting_reply: "var(--cat-awaiting)",
+  actioned: "var(--cat-actioned)",
+  marketing: "var(--cat-marketing)",
+};
+
+export const CATEGORY_LABEL_MAP: Record<string, string> = {
+  to_respond: "Responder",
+  fyi: "FYI",
+  comment: "Comentário",
+  notification: "Notificação",
+  meeting_update: "Reunião",
+  awaiting_reply: "Aguardando",
+  actioned: "Acionado",
+  marketing: "Marketing",
+};
+
+export function formatEmailDate(dateStr: string): string {
+  if (!dateStr) return "";
+  try {
+    const d = new Date(dateStr);
+    const now = new Date();
+    const diffMs = now.getTime() - d.getTime();
+    const diffMin = Math.floor(diffMs / 60_000);
+    if (diffMin < 60) return `${diffMin}min`;
+    const diffH = Math.floor(diffMin / 60);
+    if (diffH < 24) return `${diffH}h`;
+    return d.toLocaleDateString("pt-BR", { day: "2-digit", month: "short" });
+  } catch {
+    return dateStr;
+  }
+}
+
+export function extractSenderName(from: string): string {
+  const match = from.match(/^"?([^"<]+)"?\s*</);
+  return match ? match[1].trim() : from.split("@")[0];
+}
