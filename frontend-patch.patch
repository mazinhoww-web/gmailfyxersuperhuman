+function EmailDetailView({ emailId }: { emailId: string }) {
+  const { data: email, isLoading } = useEmail(emailId);
+  const [draft, setDraft] = useState<{ id: string; content: string } | null>(null);
+
+  const generateDraft = useGenerateDraft();
+  const sendDraft = useSendDraft();
+  const deleteDraft = useDeleteDraft();
+  const archiveEmail = useArchiveEmail();
+  const snoozeEmail = useSnoozeEmail();
+
+  if (isLoading || !email) {
+    return (
+      <div className="flex-1 flex items-center justify-center">
+        <Loader2 className="w-5 h-5 animate-spin text-muted-foreground" />
+      </div>
+    );
+  }
+
+  const catKey = email.category ?? "";
+  const catColor = CATEGORY_COLOR_MAP[catKey] ?? "var(--cat-fyi)";
+  const catLabel = CATEGORY_LABEL_MAP[catKey] ?? "";
+  const senderName = extractSenderName(email.from);
+  const senderEmail = email.from.match(/<([^>]+)>/)?.[1] ?? email.from;
+
+  const handleGenerateDraft = async () => {
+    const result = await generateDraft.mutateAsync({
+      messageId: email.id,
+      threadId: email.thread_id,
+    });
+    setDraft({ id: result.draft_id, content: result.content });
+  };
+
+  const handleSend = async () => {
+    if (!draft) return;
+    await sendDraft.mutateAsync(draft.id);
+    setDraft(null);
+  };
+
+  const handleDiscard = async () => {
+    if (!draft) return;
+    await deleteDraft.mutateAsync(draft.id);
+    setDraft(null);
+  };
+
+  const handleSnooze = () => {
+    snoozeEmail.mutate({ messageId: email.id, hours: 24 });
+  };
+
+  const handleArchive = () => {
+    archiveEmail.mutate(email.id);
+  };
+
   return (
