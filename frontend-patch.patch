diff --git a/src/hooks/useAriaSession.ts b/src/hooks/useAriaSession.ts
new file mode 100644
index 0000000..d506c7f
--- /dev/null
+++ b/src/hooks/useAriaSession.ts
@@ -0,0 +1,96 @@
+/**
+ * Hook to manage the ARIA backend session.
+ * Parses the session token from URL params after Google OAuth redirect,
+ * and provides the current user info.
+ */
+
+import { useEffect, useState, useCallback } from "react";
+import { useSearchParams, useNavigate } from "react-router-dom";
+import {
+  getSession,
+  setSession,
+  clearSession,
+  getAriaUser,
+  startGmailAuth,
+  logout as apiLogout,
+} from "@/services/ariaApi";
+
+export interface AriaUser {
+  user_id: string;
+  email: string;
+  name: string;
+  picture: string;
+}
+
+interface AriaSessionState {
+  session: string | null;
+  user: AriaUser | null;
+  isLoading: boolean;
+  isAuthenticated: boolean;
+  connectGmail: (supabaseUserId?: string) => void;
+  logout: () => Promise<void>;
+}
+
+export function useAriaSession(): AriaSessionState {
+  const [searchParams, setSearchParams] = useSearchParams();
+  const navigate = useNavigate();
+  const [session, setSessionState] = useState<string | null>(getSession);
+  const [user, setUser] = useState<AriaUser | null>(null);
+  const [isLoading, setIsLoading] = useState(!!getSession());
+
+  // On mount: capture session from URL if redirected from OAuth
+  useEffect(() => {
+    const urlSession = searchParams.get("session");
+    const urlEmail = searchParams.get("email");
+    const urlName = searchParams.get("name");
+    const urlPicture = searchParams.get("picture");
+
+    if (urlSession) {
+      setSession(urlSession);
+      setSessionState(urlSession);
+
+      if (urlEmail && urlName) {
+        setUser({ user_id: "", email: urlEmail, name: urlName, picture: urlPicture || "" });
+      }
+
+      // Clean URL params
+      setSearchParams({});
+    }
+  }, []);
+
+  // Load user info when session exists
+  useEffect(() => {
+    if (!session) {
+      setIsLoading(false);
+      return;
+    }
+    setIsLoading(true);
+    getAriaUser()
+      .then((u) => setUser(u))
+      .catch(() => {
+        clearSession();
+        setSessionState(null);
+      })
+      .finally(() => setIsLoading(false));
+  }, [session]);
+
+  const connectGmail = useCallback((supabaseUserId?: string) => {
+    startGmailAuth(supabaseUserId);
+  }, []);
+
+  const logout = useCallback(async () => {
+    await apiLogout();
+    setSessionState(null);
+    setUser(null);
+    navigate("/");
+  }, [navigate]);
+
+  return {
+    session,
+    user,
+    isLoading,
+    isAuthenticated: !!session && !!user,
+    connectGmail,
+    logout,
+  };
+}
